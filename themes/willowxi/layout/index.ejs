<%
  const faceValue = theme.identity && theme.identity.avatar ? theme.identity.avatar : '';
  const faceUrl = faceValue
    ? (/^(?:[a-z]+:)?\/\//i.test(faceValue) || faceValue.indexOf('data:') === 0 ? faceValue : url_for(faceValue))
    : '';
  const groups = new Map();
  page.posts.each(function(post) {
    const category = post.categories && post.categories.length
      ? post.categories.first().name
      : 'UNSORTED';
    if (!groups.has(category)) groups.set(category, []);
    groups.get(category).push(post);
  });
  const orderedGroups = Array.from(groups.entries()).sort(function(a, b) {
    return b[1][0].date.valueOf() - a[1][0].date.valueOf();
  });
  // Same source as layout.ejs: the preview cover falls back to the site
  // wallpaper, so a post with no image of its own shows one and the same
  // plate in the list and on the article page.
  const coverFallback = (theme.background && theme.background.wallpaper)
    || '/images/wallpaper/wallpaper-default.webp';
%>

<section class="home-hero">
  <div class="home-hero__noise" aria-hidden="true"></div>

  <div class="home-hero__content">
    <div class="home-hero__eyebrow">
      <span class="status-dot"></span>
      <span><%= theme.identity.status || 'ONLINE' %></span>
      <i></i>
      <span>FRAME 00 / PERSONAL ARCHIVE</span>
    </div>

    <h1>
      <span class="home-hero__name"><%= theme.identity.name || 'WillowXI' %></span>
      <span class="home-hero__cn">的小站</span>
    </h1>

    <p class="home-hero__tagline"><%= theme.identity.tagline || '' %></p>
    <p class="home-hero__description"><%= theme.identity.description || config.description %></p>

    <div class="home-hero__actions">
      <a class="button button--solid" href="#stream">
        <span><%= theme.home.direct_entry || '直接进入文章' %></span>
        <%- partial('_partial/icons', {name: 'arrow-up-right', size: 17}) %>
      </a>
      <a class="button button--ghost" href="<%- url_for('/about/') %>">
        <% if (faceUrl) { %>
          <img class="button__avatar" src="<%- faceUrl %>" alt="" loading="lazy">
        <% } else { %>
          <%- partial('_partial/icons', {name: 'user', size: 17}) %>
        <% } %>
        <span>关于我</span>
      </a>
    </div>
  </div>

  <div class="home-hero__side">
    <div class="home-hero__metric">
      <span>POSTS</span>
      <strong><%= site.posts.length.toString().padStart(2, '0') %></strong>
    </div>
    <div class="home-hero__metric">
      <span>GROUPS</span>
      <strong><%= site.categories.length.toString().padStart(2, '0') %></strong>
    </div>
    <div class="home-hero__metric">
      <span>BASE</span>
      <strong><%= theme.identity.location || 'CN' %></strong>
    </div>
  </div>

  <div class="home-hero__scroll" aria-hidden="true">
    <span>SCROLL / EXPLORE</span>
    <i></i>
  </div>
</section>

<section class="stream-section" id="stream">
  <header class="section-heading">
    <div>
      <span class="micro-label">01 / CONTENT INDEX</span>
      <h2><%= theme.home.stream_title || 'SIGNAL GROUPS' %></h2>
    </div>
    <p><%= theme.home.stream_description || '' %></p>
  </header>

  <% if (orderedGroups.length) { %>
    <div class="stream-groups">
      <% orderedGroups.forEach(function(entry, index) { %>
        <% const category = entry[0]; const posts = entry[1]; %>
        <details class="stream-group reveal">
          <summary>
            <span class="stream-group__number"><%= String(index + 1).padStart(2, '0') %></span>
            <span class="stream-group__title">
              <small>GROUP / <%= category %></small>
              <strong><span><%= category %></span></strong>
            </span>
            <span class="stream-group__count"><%= String(posts.length).padStart(2, '0') %></span>
            <span class="stream-group__toggle" aria-hidden="true">
              <%- partial('_partial/icons', {name: 'chevron-down', size: 20}) %>
            </span>
          </summary>
          <div class="stream-group__body">
            <div class="stream-group__inner">
              <%/* Phigros track select: ONE -7deg acrylic parallelogram wraps
                   both columns — every slant in here comes from that single
                   transform. The inner grid counter-skews so content stays
                   upright; the right panel flips one notch per selection. */%>
              <div class="stream-picker" data-stream-picker>
                <span class="stream-picker__plate" aria-hidden="true"></span>
                <span class="stream-picker__divider" aria-hidden="true"></span>
                <div class="stream-picker__inner">
                  <div class="stream-viewport" data-stream-viewport tabindex="0" aria-label="<%= category %> 文章选择">
                    <div class="stream-viewport__list" data-stream-list>
                      <% posts.forEach(function(post) { %>
                        <a class="stream-row" data-stream-row href="<%- url_for(post.path) %>">
                          <span class="stream-row__title"><%= post.title %></span>
                          <span class="stream-row__date"><%= date(post.date, 'YYYY.MM.DD') %></span>
                        </a>
                      <% }); %>
                    </div>
                  </div>
                  <div class="stream-detail" data-stream-detail>
                    <div class="stream-detail__track" data-stream-track>
                      <% posts.forEach(function(post) {
                        const EXCERPT_LIMIT = 112;
                        const excerptText = strip_html(post.excerpt || post.content || '').replace(/\s+/g, ' ').trim().slice(0, EXCERPT_LIMIT);
                        const coverValue = post.wallpaper || coverFallback;
                        const cover = coverValue
                          ? (/^(?:[a-z]+:)?\/\//i.test(coverValue) || coverValue.indexOf('data:') === 0 ? coverValue : url_for(coverValue))
                          : '';
                        const cat = post.categories && post.categories.length ? post.categories.first().name : 'UNSORTED';
                      %>
                        <%/* Unescaped output on purpose. The escaped form turns
                             this attribute's own quotes into the numeric entity for
                             a double quote, so the value parses as unquoted text that
                             still carries two literal quote marks — the declaration
                             is thrown away and the cover never renders. */%>
                        <article class="stream-detail__panel">
                          <div class="stream-detail__cover"<%- cover ? ' style="background-image:url(' + cover + ')"' : '' %>></div>
                          <div class="stream-detail__body">
                            <small><%= date(post.date, 'YYYY.MM.DD') %> / <%= cat %></small>
                            <h4><%= post.title %></h4>
                            <% if (excerptText) { %>
                              <p><%= excerptText %><%= excerptText.length >= EXCERPT_LIMIT ? '…' : '' %></p>
                            <% } %>
                          </div>
                          <a class="stream-detail__read" href="<%- url_for(post.path) %>">
                            <span>READ</span>
                            <%- partial('_partial/icons', {name: 'arrow-up-right', size: 15}) %>
                          </a>
                        </article>
                      <% }); %>
                    </div>
                  </div>
                </div>
                <span class="stream-viewport__count"><span data-stream-count>01</span> / <%= String(posts.length).padStart(2, '0') %></span>
              </div>
              <%/* Mobile portrait gets the original card list instead of the
                   picker — both are rendered, orientation media picks one. */%>
              <div class="stream-cards">
                <% posts.forEach(function(post) { %>
                  <%- partial('_partial/post-card', { post: post }) %>
                <% }); %>
              </div>
            </div>
          </div>
        </details>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <span>NO SIGNAL YET</span>
      <h3>第一篇记录还在路上。</h3>
      <p>运行 <code>hexo new "文章标题"</code> 后，这里会自动出现。</p>
    </div>
  <% } %>
</section>

<%- partial('_partial/pagination') %>
