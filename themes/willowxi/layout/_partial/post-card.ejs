<%
  const primaryCategory = post.categories && post.categories.length ? post.categories.first().name : 'UNSORTED';
  const excerptText = strip_html(post.excerpt || post.content || '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, theme.post.excerpt_length || 118);
  const postTags = post.tags && post.tags.length ? post.tags.toArray().slice(0, 3) : [];
%>
<article class="post-card reveal">
  <div class="post-card__rail" aria-hidden="true">
    <span><%= primaryCategory %></span>
  </div>
  <div class="post-card__content">
    <div class="post-card__meta">
      <time datetime="<%= post.date.toISOString() %>">
        <%- partial('_partial/icons', {name: 'calendar', size: 14}) %>
        <%= date(post.date, 'YYYY.MM.DD') %>
      </time>
      <span class="post-card__cat"><%= primaryCategory %></span>
    </div>

    <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
    <% if (excerptText) { %>
      <p><%= excerptText %><%= excerptText.length >= (theme.post.excerpt_length || 118) ? '…' : '' %></p>
    <% } %>

    <div class="post-card__bottom">
      <div class="post-card__tags">
        <% postTags.forEach(function(tag) { %>
          <span>#<%= tag.name %></span>
        <% }); %>
      </div>
      <a class="post-card__open" href="<%- url_for(post.path) %>" aria-label="阅读 <%= post.title %>">
        <span>READ</span>
        <%- partial('_partial/icons', {name: 'arrow-up-right', size: 16}) %>
      </a>
    </div>
  </div>
</article>
