<%
  const iconName = typeof name === 'string' ? name : '';
  const iconSize = typeof size === 'number' ? size : 18;
%>
<% if (iconName === 'arrow-up-right') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
<% } else if (iconName === 'calendar') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
<% } else if (iconName === 'chevron-down') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
<% } else if (iconName === 'menu') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
<% } else if (iconName === 'x') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
<% } else if (iconName === 'arrow-left') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
<% } else if (iconName === 'arrow-right') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
<% } else if (iconName === 'user') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
<% } else if (iconName === 'sun') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.42 1.42"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
<% } else if (iconName === 'moon') { %>
  <svg class="icon" width="<%= iconSize %>" height="<%= iconSize %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
<% } %>
