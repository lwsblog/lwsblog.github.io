<%
  const background = theme.background || {};
  const defaultWallpaper = background.wallpaper || '/images/wallpaper/wallpaper-default.webp';
  // The About page rides the post channel: same pending curtain, same
  // line-enter transition and staged reveal as entering an article.
  const isPostLike = is_post() || page.layout === 'about';
  const pageWallpaper = isPostLike && page.wallpaper ? page.wallpaper : defaultWallpaper;

  function resolveBackgroundUrl(value) {
    if (/^(?:[a-z]+:)?\/\//i.test(value) || /^data:/i.test(value)) return value;
    return url_for(value);
  }

  const wallpaperUrl = resolveBackgroundUrl(pageWallpaper);
  const defaultWallpaperUrl = resolveBackgroundUrl(defaultWallpaper);
%>
<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
  <%- partial('_partial/head') %>
  <body
    class="<%= is_home() ? 'is-home' : 'is-inner' %><%= isPostLike ? ' is-post' : '' %>"
    data-wallpaper="<%= wallpaperUrl %>"
    data-default-wallpaper="<%= defaultWallpaperUrl %>"
  >
    <div class="scene-background" data-scene-background aria-hidden="true">
      <img class="scene-background__wallpaper" data-scene-wallpaper alt="">
      <div class="scene-background__acrylic"></div>
      <canvas class="scene-background__canvas" data-scene-canvas></canvas>
      <!-- Reveal is done by dissolving this plate rather than by fading the
           wallpaper in, so blur() is rasterised once and never re-computed. -->
      <div class="scene-background__plate"></div>
    </div>

    <!-- The bar lives outside .app-shell on purpose: that wrapper is a
         stacking context (z-index: 1), which would trap the bar underneath
         the route overlays no matter how high its own z-index is. -->
    <%- partial('_partial/header') %>

    <div class="app-shell">
      <% if (is_home() && theme.intro && theme.intro.enabled !== false) { %>
        <%- partial('_partial/intro') %>
      <% } %>

      <main id="main" class="main-content" data-pjax-container>
        <%- body %>
      </main>

      <%- partial('_partial/footer') %>
    </div>

    <div class="route-exit" data-route-exit aria-hidden="true"></div>

    <div class="home-return" data-home-return-transition aria-hidden="true"></div>

    <div class="theme-transition" data-theme-transition aria-hidden="true"></div>

    <div class="route-transition <%= isPostLike ? 'is-pending' : 'is-complete' %>" data-route-transition aria-hidden="true">
      <div class="route-transition__veil route-transition__veil--top"></div>
      <div class="route-transition__veil route-transition__veil--bottom"></div>
      <div class="route-transition__seam">
        <span class="route-transition__line"></span>
      </div>
    </div>

    <script>
      window.WILLOWXI_THEME = <%- JSON.stringify({
        introDuration: theme.intro && theme.intro.duration ? theme.intro.duration : 5900,
        introEnabled: is_home() && !!(theme.intro && theme.intro.enabled !== false),
        defaultWallpaper: defaultWallpaperUrl,
        desktopMinWidth: Number(background.desktop_min_width) || 769,
        gridSpacing: Number(background.grid_spacing) || 168,
        mobileGridSpacing: Number(background.mobile_grid_spacing) || 42,
        revealDelay: Number(background.reveal_delay) >= 0 ? Number(background.reveal_delay) : 0.5,
        revealDuration: Number(background.reveal_duration) >= 0 ? Number(background.reveal_duration) : 1,
        sweepDuration: Number(background.sweep_duration) || 4,
        sweepDelay: Number(background.sweep_delay) >= 0 ? Number(background.sweep_delay) : 1,
        parallaxWallpaper: Number(background.parallax_wallpaper) > 0 ? Number(background.parallax_wallpaper) : 14,
        parallaxWallpaperY: Number(background.parallax_wallpaper_y) > 0 ? Number(background.parallax_wallpaper_y) : 14,
        parallaxGrid: Number(background.parallax_grid) > 0 ? Number(background.parallax_grid) : 7,
        home: is_home(),
        homePath: url_for('/'),
        search: (theme.search && theme.search.enabled !== false) ? {
          // The hash comes from the generator (scripts/search-index.js) and
          // rides on the query string, so an updated index is a new URL and
          // /search-index.json can stay immutable in _headers.
          index: url_for('/search-index.json') + '?v=' + (typeof search_index_hash !== 'undefined' && search_index_hash ? search_index_hash : '0'),
          engine: url_for('/vendor/flexsearch/flexsearch.compact.min.js'),
          placeholder: (theme.search && theme.search.placeholder) || '搜索',
          synonyms: (theme.search && theme.search.synonyms) || {}
        } : null,
        waline: (theme.waline && theme.waline.serverURL) ? {
          serverURL: theme.waline.serverURL,
          js: url_for('/vendor/waline/waline.js'),
          css: url_for('/vendor/waline/waline.css')
        } : null
      }) %>;
    </script>
    <script src="<%- url_for('/js/willowxi.js') %>?v=<%- Date.now() %>" defer></script>
  </body>
</html>
