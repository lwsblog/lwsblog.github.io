<article class="standalone page-enter">
  <header class="standalone__header">
    <span class="micro-label">PAGE / <%= page.title %></span>
    <h1><%= page.title %></h1>
    <% if (page.description) { %><p><%= page.description %></p><% } %>
  </header>
  <div class="standalone__rule"></div>
  <div class="standalone__body prose">
    <%- page.content %>
  </div>
</article>
