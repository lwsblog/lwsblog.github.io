<%
  // 相册。图片清单在 source/_data/photos.yml（三档真身：screen/thumb/light）。
  // 屏风只从横屏图里随机抽一张，竖图不进池；抽中的那张同时是主体网格的
  // 第一格，所以屏风退场时相纸落回自己的位置，而不是落到别的图上。
  const photos = (site.data && site.data.photos) ? site.data.photos : [];
  const pool = photos.filter(function (p) { return Number(p.w) > Number(p.h); });
  // The screen only ever shows a landscape frame, and whichever one it picks
  // is moved to the head of the grid. The print therefore lands on its own
  // photo instead of on an unrelated one, and the head of the grid is also
  // the first thing under the screen at the end of the travel.
  const cover = pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
  const ordered = cover
    ? [cover].concat(photos.filter(function (p) { return p !== cover; }))
    : photos.slice();
  const stamp = function (value) {
    if (!value) return '—';
    const parts = String(value).split('-');
    return parts.length === 3 ? parts[0] + '.' + parts[1] + '.' + parts[2] : String(value);
  };
  const photoUrl = function (id, tier) {
    return url_for('/images/photos/' + id + '-' + tier + '.webp');
  };
  const landscape = photos.filter(function (p) { return Number(p.w) > Number(p.h); }).length;
%>
<!-- The masthead is a page-level fixed layer, NOT part of the screen. It is
     the one element that carries the title from the middle of the screen to
     the top-left corner and then stays there for the rest of the session —
     it is never faded out and re-shown, because that reads as a blink. The
     screen below it can be display:none once it lands and the title is
     untouched. -->
<div class="photo-masthead" data-photo-masthead>
  <span class="photo-masthead__label" data-photo-mast-label>CONTACT SHEET</span>
  <h1 class="photo-masthead__title" data-photo-mast-title><%= page.title %></h1>
  <p class="photo-masthead__sub" data-photo-mast-sub>
    <%= photos.length %> FRAMES / <%= landscape %> LANDSCAPE / <%= photos.length - landscape %> PORTRAIT
  </p>
</div>

<div class="gallery" data-gallery>
  <!-- The global acrylic. One full-viewport plate that sits BETWEEN the grid
       and the print: it blurs and dims the whole column while the print is
       still travelling, and fades out as the print lands. Without it the grid
       is naked the moment the print shrinks off it, and the cell the print is
       flying towards — the same photograph, its own landing site — shows
       through beside it, so one travel reads as two copies of one photo.
       The plate fades by animating --acrylic-k (see willowxi.css); it is
       never taken to opacity < 1, which would make it its own backdrop root
       and kill its own blur. -->
  <div class="photo-acrylic" data-photo-acrylic aria-hidden="true"></div>

  <!-- The screen is a print the size of the viewport, not a full-bleed
       photograph. It holds the SAME aspect ratio as the grid cell it lands
       on, so the whole travel is one continuous scale of one box: the crop
       never changes, nothing is re-cropped, and no second image is ever
       created. That is what makes it read as one print shrinking rather than
       one photo being replaced by another. -->
  <figure class="photo-screen" data-photo-screen>
    <% if (cover) { %>
      <img class="photo-screen__img" data-photo-screen-img
        src="<%- photoUrl(cover.id, 'screen') %>" alt="" decoding="async" draggable="false">
    <% } %>
    <div class="photo-screen__veil" data-photo-screen-veil></div>
    <figcaption class="photo-screen__cap" data-photo-screen-cap>
      <span><%= stamp(cover ? cover.date : '') %></span>
      <!-- The print IS the head of the grid (see the `ordered` list above),
           so its tally has to be the tally that cell shows — "01", not the
           collection total. With the total here the arrival swapped 22 -> 01
           on the one frame where the print hands over to its own cell, which
           is a visible edit in the middle of a transition that is supposed to
           have no seam. The collection total lives in the masthead's sub. -->
      <span>01</span>
    </figcaption>
  </figure>

  <p class="photo-screen__hint" data-photo-screen-hint>SCROLL</p>

  <div class="gallery-spacer" data-gallery-spacer></div>

  <div class="photo-main" data-photo-main>
    <!-- The backboard. It is the first child of the column and absolutely
         positioned against it, so the column is mounted ON it rather than the
         board floating over the viewport. -->
    <div class="gallery-board" aria-hidden="true"></div>

    <header class="photo-main__header">
      <span class="micro-label">ALBUM / <%= page.title %></span>
      <% if (page.description) { %><p><%= page.description %></p><% } %>
    </header>

    <div class="photo-grid" data-photo-grid>
      <% ordered.forEach(function (photo, index) { %>
        <%
          const ratio = (Number(photo.w) / Number(photo.h)).toFixed(4);
          const wide = Number(photo.w) / Number(photo.h) > 2;
        %>
        <figure class="photo-frame<%= wide ? ' photo-frame--wide' : '' %>" data-photo-frame
          data-index="<%= index %>" data-id="<%= photo.id %>"
          style="--ratio: <%= ratio %>">
          <button class="photo-frame__hit" type="button"
            aria-label="放大第 <%= index + 1 %> 帧：<%= stamp(photo.date) %>">
            <img class="photo-frame__img" data-photo-frame-img
              src="<%- photoUrl(photo.id, 'thumb') %>"
              alt="<%= stamp(photo.date) %>" loading="lazy" decoding="async"
              width="<%= photo.w %>" height="<%= photo.h %>" draggable="false"
              data-light-src="<%- photoUrl(photo.id, 'light') %>">
          </button>
          <figcaption class="photo-frame__cap">
            <span><%= stamp(photo.date) %></span>
            <span><%= String(index + 1).padStart(2, '0') %></span>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  </div>

  <div class="photo-lightbox" data-photo-lightbox hidden>
    <div class="photo-lightbox__veil" data-photo-lightbox-veil></div>
    <figure class="photo-lightbox__stage" data-photo-lightbox-stage>
      <img class="photo-lightbox__img" data-photo-lightbox-img alt="" decoding="async">
      <figcaption class="photo-lightbox__cap">
        <span data-photo-lightbox-label></span>
        <span data-photo-lightbox-index></span>
      </figcaption>
    </figure>
    <button class="photo-lightbox__nav photo-lightbox__nav--prev" type="button"
      data-photo-lightbox-prev aria-label="上一帧">
      <%- partial('_partial/icons', {name: 'arrow-left', size: 22}) %>
    </button>
    <button class="photo-lightbox__nav photo-lightbox__nav--next" type="button"
      data-photo-lightbox-next aria-label="下一帧">
      <%- partial('_partial/icons', {name: 'arrow-right', size: 22}) %>
    </button>
    <button class="photo-lightbox__close" type="button" data-photo-lightbox-close aria-label="关闭">
      <%- partial('_partial/icons', {name: 'x', size: 20}) %>
    </button>
    <p class="photo-lightbox__hint" data-photo-lightbox-hint>&larr; &rarr; 切换 · ESC 关闭</p>
  </div>
</div>
