<%
  // 相册。图片清单在 source/_data/photos.yml（三档真身：screen/thumb/light）。
  // 屏风只从横屏图里随机抽一张，竖图不进池；抽中的那张同时是主体网格的
  // 第一格，所以屏风退场时相纸落回自己的位置，而不是落到别的图上。
  const photos = (site.data && site.data.photos) ? site.data.photos : [];
  const pool = photos.filter(function (p) { return Number(p.w) > Number(p.h); });
  // The screen only ever shows a landscape frame, and whichever one it picks
  // is moved to the head of the grid. The print therefore lands on its own
  // photo instead of on an unrelated one, and the head of the grid is also
  // the first thing under the screen at the end of the travel.
  const cover = pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
  const ordered = cover
    ? [cover].concat(photos.filter(function (p) { return p !== cover; }))
    : photos.slice();
  const stamp = function (value) {
    if (!value) return '—';
    const parts = String(value).split('-');
    return parts.length === 3 ? parts[0] + '.' + parts[1] + '.' + parts[2] : String(value);
  };
  const photoUrl = function (id, tier) {
    return url_for('/images/photos/' + id + '-' + tier + '.webp');
  };
  const landscape = photos.filter(function (p) { return Number(p.w) > Number(p.h); }).length;
%>

<!-- 相册的数据源：3D 相册用 collect() 读这些 [data-photo-frame] 取图片清单
     （data-id / --ratio / data-screen-src / data-light-src）。
     这里是【纯数据】：没有 <img>、没有按钮、没有说明文字，也整块隐藏，
     所以旧的列表/网格视图不会出现在页面上，也不会播任何入场动画。 -->
<div class="album-data" hidden aria-hidden="true">
  <% ordered.forEach(function (photo, index) { %>
    <figure data-photo-frame
            data-id="<%= photo.id %>"
            data-index="<%= index + 1 %>"
            data-screen-src="<%= photoUrl(photo.id, 'screen') %>"
            data-light-src="<%= photoUrl(photo.id, 'light') %>"
            style="--ratio:<%= (Number(photo.w) / Number(photo.h)).toFixed(5) %>"></figure>
  <% }) %>
</div>

